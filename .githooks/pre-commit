#!/bin/bash
# Pre-commit gate — banxe-emi-stack. Direct local tools (pre-commit framework broken on
# this host: pip-env ImportError). Order mirrors .pre-commit-config.yaml.
# SCOPE: gates run over STAGED files only (guard NEW code the Factory commits) — not the
# whole legacy tree. Repo-wide legacy debt (e.g. 2 bandit HIGH in agents/recorders.py,
# watchdog/prometheus_exporter.py) is tracked separately, not a per-commit blocker.
# Heavy pytest runs in pre-push.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"
fail() { echo "❌ $1"; exit 1; }

# 0. CANON role-guard (always)
"$ROOT/.githooks/role-guard.sh" || exit 1

# staged python files (ACM = added/copied/modified)
mapfile -t PY < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
echo "🔍 Pre-commit gate (staged: ${#PY[@]} py files)..."

if [ "${#PY[@]}" -gt 0 ]; then
    # 1. ruff lint (staged only)
    command -v ruff >/dev/null 2>&1 && { echo "→ ruff"; ruff check "${PY[@]}" -q || fail "ruff lint issues (staged)"; }
    # 2. bandit HIGH (staged only)
    command -v bandit >/dev/null 2>&1 && { echo "→ bandit"; bandit -ll -q "${PY[@]}" >/dev/null 2>&1 || fail "bandit HIGH finding (staged)"; }
    # 3. mypy on staged src/ files only
    SRC=$(printf '%s\n' "${PY[@]}" | grep '^src/' || true)
    [ -n "$SRC" ] && { echo "→ mypy (staged src/)"; python3 -m mypy $SRC --ignore-missing-imports --no-error-summary || fail "mypy errors (staged src/)"; }
fi

# 4. IAM creds guard on STAGED yaml/json only
mapfile -t CFG < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ya?ml|json)$' || true)
if [ "${#CFG[@]}" -gt 0 ]; then
    echo "→ IAM creds guard"
    for f in "${CFG[@]}"; do
        [ -f "$f" ] || continue
        grep -nE '(password|client_secret|db_password|api_key|auth_token|access_token|private_key)[[:space:]]*[:=][[:space:]]*"[^"$<{]{4,}"' "$f" \
          | grep -vE '\.semgrep|node_modules' && fail "INV-IAM-01: credential literal in $f"
    done
fi

# 5. semgrep banxe-rules on STAGED code files only
RULES="$ROOT/.semgrep/banxe-rules.yml"
if command -v semgrep >/dev/null 2>&1 && [ -f "$RULES" ] && [ "${#PY[@]}" -gt 0 ]; then
    echo "→ semgrep (banxe-rules, staged)"
    semgrep --config "$RULES" --error --quiet "${PY[@]}" || fail "semgrep ERROR finding (staged)"
fi

echo "✅ Pre-commit gate passed (staged-scoped; pytest in pre-push)"
