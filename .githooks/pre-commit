#!/bin/bash
# Pre-commit quality scan — banxe-emi-stack
# Primary: LucidShark MCP (when connected in Claude Code). CLI fallback: semgrep with
# the repo's OWN fintech rules (.semgrep/banxe-rules.yml), NOT generic --config=auto.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
RULES="$ROOT/.semgrep/banxe-rules.yml"

# CANON role-guard first (operating-mode.md), then quality scan
"$(git rev-parse --show-toplevel)/.githooks/role-guard.sh" || exit 1

echo "🔍 Pre-commit quality scan..."

if command -v lucidshark >/dev/null 2>&1 && lucidshark --version 2>/dev/null | grep -qvE '0\.0\.0\.dev'; then
    echo "→ LucidShark CLI"
    lucidshark scan --fail-on=critical || { echo "❌ LucidShark critical issues."; exit 1; }
elif command -v semgrep >/dev/null 2>&1; then
    if [ -f "$RULES" ]; then
        echo "→ semgrep with banxe fintech rules ($RULES)"
        semgrep scan --config "$RULES" --error --severity=ERROR "$ROOT/services" "$ROOT/api" "$ROOT/src" \
            || { echo "❌ semgrep (banxe-rules) found ERROR-level issues."; exit 1; }
    else
        echo "⚠️ banxe-rules.yml missing — semgrep auto config"
        semgrep scan --config=auto --error --severity=ERROR || { echo "❌ semgrep issues."; exit 1; }
    fi
else
    echo "❌ No scanner available (neither LucidShark nor semgrep)."; exit 1
fi
echo "✅ Quality scan passed"
